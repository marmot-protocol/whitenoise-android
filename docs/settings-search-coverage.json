  "exclusions": {
    "account values": "Names, npubs, keys, profile text and pictures are never metadata; index only static management labels.",
    "relay entities": "Relay URLs/names, live publication status and per-relay edit/remove rows are user data. Add/restore management remains indexed.",
    "blocked entities": "Individual blocked identities are private user data. Blocked users management remains indexed.",
    "folder entities": "Custom folder names/order and folder editor values are private user data. Chat folders management and restore remain indexed.",
    "emoji entities": "Shortcodes, imported images and per-image removal identify user content. Import management remains indexed.",
    "agent connectors": "Connector setup options are represented by the AI Agents management destination; copied setup payload and account key are never indexed.",
    "picker choices": "Theme/font/color/voice/engine/language/network/gesture choices are reached through their owning controls, rather than indexed as independent settings.",
    "transient errors": "Retry, permission-grant failure, storage recovery and update-install progress actions exist only during a transient state and retain their visible parent management entry.",
    "dictation recommendation": "Optional external-provider installation recommendation depends on installed packages and is represented by Dictation management, not an always-present control.",
    "developer demo cleanup": "Cleanup/retry actions depend on transient demo state; Review demo management remains indexed.",
    "developer seed fixture": "Seed fixture is a non-production test-only injected control, absent from shipping runtime.",
    "build information": "Read-only version/build/native revision/staging indicators are represented by About/Developer management, with no dynamic build-value indexing.",
    "storage entities": "Per-chat storage rows and individual attachment names, origins, sizes and selection are user-generated content. Manage storage and its static free-up/Keep media controls remain indexed."
  },
  "non_row_exclusions": {
    "navigation": "Back and search affordances are navigation, not searchable settings.",
    "transactions": "Picker Save/reset/preview, dialogs, confirmations, relay editor submit/roles and connector setup copy prompt are transient flows represented by their existing owner control.",
    "private_entities": "Per-folder/package/identity actions and profile/QR/prompt values are dynamic or private; never indexed.",
    "recovery": "Error-only retries and dismissal actions are transient recovery controls."
  }
