<resources>
    <string name="header_shortcuts_title">聊天标题栏快捷按钮</string>
    <string name="header_shortcut_search">在聊天中搜索</string>
    <string name="header_shortcuts_limit">最多两个。请先取消勾选一个。</string>
    <string name="explanation_header_shortcut_search">在每个聊天的标题栏显示搜索按钮。它打开的搜索与聊天详情中的相同。仅适用于此设备。</string>
    <string name="explanation_header_shortcut_mute">在每个聊天的标题栏显示静音按钮。静音时会询问时长；取消静音会立即生效。仅适用于此设备。</string>
    <string name="explanation_header_shortcut_read_aloud">在每个聊天的标题栏显示朗读按钮。它会为该聊天开启或关闭新消息朗读，与聊天详情中的相同。仅适用于此设备。</string>
    <string name="header_shortcuts_hint">标题栏最多显示两个，按你勾选的顺序排列。</string>
    <string name="conversation_header_timer_change">更改阅后即焚消息计时器</string>
