<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/conversation_widget_background">
    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/conversation_widget_foreground"
        android:textSize="18sp" android:textStyle="bold" android:minHeight="48dp" />
    <LinearLayout android:id="@+id/widget_rows"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_refresh"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/retry" android:textColor="@color/conversation_widget_foreground"
        android:textSize="14sp" android:minHeight="48dp" android:gravity="center_vertical" />
</LinearLayout>
