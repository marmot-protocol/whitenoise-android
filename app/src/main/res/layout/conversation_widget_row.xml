<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:minHeight="48dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/widget_row_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/conversation_widget_foreground"
        android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_row_subtitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/conversation_widget_foreground"
        android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
