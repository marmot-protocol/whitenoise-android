<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/reaction_choices_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <ImageView
            android:id="@+id/reaction_choices_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/reaction_choices_first"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal" />
    <LinearLayout
        android:id="@+id/reaction_choices_second"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal" />
    <TextView
        android:id="@+id/reaction_choices_body"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:id="@+id/reaction_choices_messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
