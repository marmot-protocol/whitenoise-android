<resources>
    <string name="learn_white_noise">了解 White Noise</string>
    <string name="learn_find_title">尋找聯絡人</string>
    <string name="learn_find_body">開啟新聊天，貼上對方的個人資料連結或掃描 QR 碼。如果搜尋姓名找不到，請向對方索取個人資料連結。</string>
