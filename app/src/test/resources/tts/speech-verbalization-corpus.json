{
  "schema_version": 1,
  "purpose": "Expected prose verbalization for read-aloud. Expectations are authored independently of the production verbalizer and must never be regenerated from it.",
  "spoken_core_contract": "expected_spoken_core is the exact lexical core, ignoring only added terminal sentence punctuation and outer whitespace.",
  "literal_contract": "expected_literal requires the complete source token to survive verbatim in the spoken text, covered by one identity origin run over its whole source span.",
