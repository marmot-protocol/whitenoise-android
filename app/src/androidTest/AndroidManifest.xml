<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.external-share-test-files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/external_share_test_paths" />
        </provider>

        <activity
            android:name="dev.ipf.whitenoise.android.share.ExternalShareDispatchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":external-share-test-source"
            android:taskAffinity="dev.ipf.whitenoise.android.external-share-test-source" />
    </application>
</manifest>
