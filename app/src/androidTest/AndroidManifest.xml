<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Instrumentation resolves these providers using the test package's visibility. -->
    <queries>
        <package android:name="dev.ipf.fixture" />
        <provider android:authorities="dev.ipf.fixture.documents;dev.ipf.fixture.status" />
    </queries>
    <application>
        <provider
            android:name="dev.ipf.whitenoise.android.share.ExternalShareTestFileProvider"
            android:authorities="${applicationId}.external-share-test-files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name="dev.ipf.whitenoise.android.share.ExternalShareDispatchActivity"
            android:excludeFromRecents="true"
            android:exported="true" />

        <activity
            android:name="dev.ipf.whitenoise.android.share.OutboundShareTestTargetActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
