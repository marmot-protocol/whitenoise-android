# UniFFI-generated Kotlin bindings: regenerated wholesale by the bindings
# script, so don't whitespace-lint them (the generator emits trailing spaces)
# and mark them generated so reviews collapse the diff.
app/src/main/java/dev/ipf/marmotkit/marmot_uniffi.kt -whitespace linguist-generated

# Reviewed upstream licence bytes retain their original whitespace and LF encoding.
config/licenses/texts/*.txt -whitespace -text
# File digests in the review manifest remain stable on CRLF-default checkouts.
**/*gradle.lockfile text eol=lf
gradle/verification-metadata.xml text eol=lf
gradle/dependency-inputs.json text eol=lf
# Retained publisher metadata is authenticated byte-for-byte.
gradle/publication-metadata/*.module -text
