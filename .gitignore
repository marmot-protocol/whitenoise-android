local.properties

# Firebase project config. Tied to a specific Firebase project per
# environment; provisioned out of band rather than checked in.
app/google-services.json

# Generated only by the trusted Android Staging APK workflow. Keeping this
# untracked prevents local, preview, and pull-request builds from inheriting a
# stale trusted-build attestation.
app/src/staging/assets/whitenoise-audit-attestation-v1.json

# Claude Code local runtime state
.claude/

# Kotlin incremental/compile artifacts
.kotlin/

.env

# Local review-agent reports, never shipped
/reviews/

# Fuzz module generated state (never commit)
/fuzz/build/
/fuzz/.cifuzz-corpus/
/fuzz/fuzz-*.log
/fuzz/build/fuzz-campaign-logs/
